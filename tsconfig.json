{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": ["env.d.ts", "src/**/*", "src/**/*.vue", "package"],
  "compilerOptions": {
    "isolatedModules": false,
    "noImplicitAny": true,
    "strict": true,
    "paths": {
      "@/*": ["./src/*"]
    },
    // Added to allow Object.hasOwn(). We are targeting the latest versions of javascript.
    "target": "ES2022"
  },

  "references": [
    {
      "path": "./tsconfig.node.json"
    }
  ]
}
